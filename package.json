{
  "name": "deskpet-nailong",
  "version": "0.1.0",
  "private": true,
  "description": "奶蛙桌宠的最小可用版本",
  "author": "wendy",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "test:render": "npm run build && electron scripts/check-render.cjs",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "io.github.wendy.deskpet-nailong",
    "productName": "DeskPet-naiLong",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "src/characters/personas/**/*",
      "素材/奶蛙/processed/**/*",
      "素材/噜噜/**/*",
      "素材/大奶蛙/**/*",
      "素材/罗小黑/**/*",
      "!**/*.processed.debug.png",
      "!**/*.test.ts"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "allowScripts": {
    "uiohook-napi@1.5.5": true
  }
}
